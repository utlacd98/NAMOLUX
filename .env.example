# OpenAI API Key
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
# Optional: override Vercel AI Gateway's automatic OIDC authentication for CI.
# Leave unset on Vercel; deployments use VERCEL_OIDC_TOKEN automatically.
AI_GATEWAY_API_KEY=

# Supabase Authentication & Database
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Random server-only value used to pseudonymise anonymous quota identifiers.
ANONYMOUS_ID_PEPPER=replace_with_at_least_32_random_characters

# Stripe (GBP Pricing)
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here
# Create webhook at: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Create a recurring GBP £7.99/month Price at: https://dashboard.stripe.com/products
STRIPE_PRICE_PRO=price_your_799_monthly_price_id_here
# Optional legacy fallback. Checkout still validates this is GBP £7.99/month before use.
STRIPE_PRICE_ID=

# App URL
NEXT_PUBLIC_APP_URL=https://namolux.com
# Public decision-workspace rollout switch. Leave enabled during preview and
# public launch; set false only for an immediate, reversible rollback.
NAMOLUX_DECISION_WORKSPACE_ENABLED=true
# Emergency switch for the signed-in production Name Sprint. When true, the
# engine also requires final admissions and one bounded current-web screen.
NAMOLUX_NAME_SPRINT_ENABLED=false

# Generator experiments run only in the separate protected lab deployment.
# Never set this true in the public production project.
NAMOLUX_ENABLE_GENERATOR_LAB=false
NAMOLUX_GENERATOR_LAB_HOST=lab.namolux.com
NAMOLUX_DAILY_LAUNCH_SIGNAL_ENABLED=false
NAMOLUX_AUTONOMOUS_SCOUT_ENABLED=false
# Set only after the representative provider, latency, duplicate, safety, and blind-quality audit passes.
NAMOLUX_SCOUT_QUALITY_GATE_PASSED=false
# Preview-only, comma-separated internal Scout tester allowlist. Never configure in Production.
NAMOLUX_SCOUT_INTERNAL_TESTER_EMAILS=
# Local queue development only. Vercel production uses its OIDC credentials.
VERCEL_QUEUE_API_TOKEN=
# Server-only secret used by Vercel to authenticate scheduled SEO monitoring.
# Generate at least 32 random characters and configure the same value in Vercel.
CRON_SECRET=replace_with_at_least_32_random_characters
# Optional. When absent, Founder Signal labels real-user performance metrics as unavailable.
PAGESPEED_INSIGHTS_API_KEY=
# Optional bounded batch size for each scheduled invocation (1-10, default 5).
SEO_CRON_BATCH_SIZE=5
GROQ_API_KEY=
GROQ_QUICK_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b
# Independent fast editorial recovery after a 120B transport/rate-limit
# failure. Keep this distinct from the primary model.
GROQ_QUICK_EDITOR_MODEL=openai/gpt-oss-20b
AI_GATEWAY_QUICK_MODEL=google/gemini-2.5-flash
GROQ_QUICK_MODEL=
# Defaults to Groq-first. Set both values below only after an OpenAI preview
# passes the generator quality and latency gates.
QUICK_GENERATE_PRIMARY_PROVIDER=groq
# Leave false so Gateway/20B/Qwen can recover a safe batch when the primary is
# rate-limited. true deliberately fails closed on any primary failure.
QUICK_GENERATE_PRIMARY_ONLY=false
OPENAI_QUICK_MODEL=gpt-4.1-mini
# Optional GPT-5 A/B override: none, minimal or low. Unsupported values are
# ignored; legacy GPT-5 mini never receives the unsupported none setting.
OPENAI_QUICK_REASONING_EFFORT=

# Advertising. Manual responsive units only; keep AdSense Auto ads disabled.
# Keep ADS_ENABLED=false until the site and Google's Privacy & messaging
# European regulations message are approved and published.
ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-1814097435957151
NEXT_PUBLIC_ADSENSE_GENERATOR_SLOT=

# Candidate-first Quick/Advanced generator rollout (server controlled).
GENERATOR_REDESIGN_V2=false
# Emergency holds return retryable 503s without charging quota. Set both false
# only after the deployed version passes its production smoke test.
QUICK_GENERATE_EMERGENCY_HOLD=false
ADVANCED_GENERATE_EMERGENCY_HOLD=false
# Optional dedicated slot for Founder Signal/results placements. Falls back to HORIZONTAL_SLOT.
NEXT_PUBLIC_ADSENSE_RESULTS_SLOT=
NEXT_PUBLIC_ADSENSE_BLOG_SLOT=
NEXT_PUBLIC_ADSENSE_HORIZONTAL_SLOT=
NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT=
# Optional dedicated journal slot. Falls back to BLOG_SLOT.
NEXT_PUBLIC_ADSENSE_JOURNAL_SLOT=
# Renders labelled placeholders without contacting Google (local/staging only).
NEXT_PUBLIC_ADS_TEST_MODE=false
## Lab-only guided generator and private social-video delivery
NAMOLUX_GENERATOR_LAB_V3=false
OPENAI_NAMING_MODEL=gpt-5.6-luna
OPENAI_NAME_SPRINT_MODEL=gpt-5.6-luna
OPENAI_NAME_SPRINT_REPAIR_MODEL=gpt-5.6-luna
# Lab overrides. The public switch above enables these launch gates together.
NAMOLUX_NAME_SPRINT_EXPENSIVE_REPAIR=false
NAMOLUX_NAME_SPRINT_AI_ADMISSIONS=false
NAMOLUX_NAME_SPRINT_WEB_COLLISION=false
# Keep enabled in the private lab so finalists carry fresh domain evidence.
NAMOLUX_NAME_SPRINT_DOMAIN_CHECKS=true
VIDEO_DOWNLOAD_SIGNING_SECRET=
VIDEO_DOWNLOAD_BLOB_PATHNAME=deliveries/namolux-social-ad-final.mp4
BLOB_READ_WRITE_TOKEN=
